# ==============================================================================
# KYOKA LAVALINK V4 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local testing or set these variables in the Render Dashboard.
# NEVER commit your actual .env file or real passwords to GitHub!
# ==============================================================================

# Port to bind (Render dynamically injects $PORT in production)
PORT=10000

# Secure Server Password (REQUIRED - Refuses to boot if missing or empty)
# Generate a strong password using: python scripts/generate_password.py
LAVALINK_SERVER_PASSWORD=

# Conservative Memory Tuning for Render Free 512 MB Container limit
JAVA_OPTS=-Xmx256m -Xms96m -XX:MaxMetaspaceSize=72m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=32m -Xss384k -XX:+UseG1GC -XX:MaxGCPauseMillis=100 -XX:+ExitOnOutOfMemoryError -XX:+UseStringDeduplication

# Spotify Metadata Integration via LavaSrc (Optional - required only for Spotify link resolution)
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Render Public Endpoint (Used by health check & 24/7 keep-alive scripts)
# Example: https://kyoka-lavalink.onrender.com
RENDER_SERVICE_URL=
